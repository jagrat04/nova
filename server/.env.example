# ---------------------------------------------------------------------------
# DATABASE_URL  - used by the running app (pooled connection in production)
# DIRECT_URL    - used by `prisma migrate` only; must be a DIRECT connection.
#                 Neon's pooled host contains "-pooler"; the direct one does not.
#                 Locally, point both at the same server.
#
# Local:  postgresql://postgres:PASSWORD@localhost:5432/nova?schema=public
# Neon:   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nova?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nova?schema=public"

# Secret used to sign JWTs. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins
CLIENT_ORIGIN="http://localhost:5173"
